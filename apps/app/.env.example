EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_API_URL=http://localhost:3001
# Only enable for an explicitly device-local demonstration. Never for production.
EXPO_PUBLIC_DEMO_MODE=false
# Enable Google only after configuring the provider and callback allowlist.
EXPO_PUBLIC_GOOGLE_AUTH_ENABLED=false
# SMS requires a delivery provider; keep disabled for the free email-OTP setup.
EXPO_PUBLIC_SMS_AUTH_ENABLED=false
